{
  "name": "hexopress",
  "version": "1.4.0",
  "private": true,
  "description": "A client software for Hexo blog.",
  "license": "MIT",
  "author": {
    "name": "Charles",
    "email": "charlestang@foxmail.com"
  },
  "main": ".vite/build/main.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.5.5"
  },
  "scripts": {
    "check-all": "concurrently -c \"bgBlue.bold,bgMagenta.bold,bgCyan.bold,bgGreen.bold\" npm:vue-check npm:vitest-check npm:node-check npm:conf-check",
    "conf-check": "tsc --noEmit -p tsconfig/tsconfig.tools.json",
    "dev": "electron-forge start",
    "format": "prettier --write src/ main/ web/ types/ *.ts *.mts *.json *.md",
    "web:dev": "concurrently \"vite --config vite.config.web.mts\" \"npm run web:server && node dist/server.cjs --dev\"",
    "web:build": "vite build --config vite.config.web.mts && npm run web:server",
    "web:server": "esbuild web/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --alias:@shared=./shared --packages=external",
    "lint": "eslint . --fix",
    "make": "electron-forge make",
    "node-check": "tsc --noEmit -p tsconfig/tsconfig.node.json",
    "package": "electron-forge package",
    "publish": "electron-forge publish",
    "start": "electron-forge start",
    "test": "vitest",
    "vitest-check": "vue-tsc --noEmit -p tsconfig/tsconfig.vitest.json",
    "vue-check": "vue-tsc --noEmit -p tsconfig/tsconfig.app.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@replit/codemirror-vim": "^6.4.0",
    "date-fns": "^4.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "element-plus": "^2.14.7",
    "fastify": "^5.12.5",
    "hexo": "^8.1.2",
    "hexo-front-matter": "^5.0.0",
    "hexo-fs": "^5.0.1",
    "hexo-util": "^4.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "path-browserify": "^1.0.1",
    "pinia": "^4.0.3",
    "una-editor": "^0.4.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "vue3-calendar-heatmap": "^2.0.5",
    "@vue/devtools-api": "^8.2.1"
  },
  "overrides": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tsconfig/node20": "^20.1.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/path-browserify": "^1.0.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13",
    "web-storage-cache": "^1.1.1"
  },
  "productName": "HexoPress"
}
