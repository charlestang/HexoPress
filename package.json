{
  "name": "hexopress",
  "version": "1.4.0",
  "private": true,
  "description": "A client software for Hexo blog.",
  "license": "MIT",
  "author": {
    "name": "Charles",
    "email": "charlestang@foxmail.com"
  },
  "main": ".vite/build/main.js",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=10.5.5"
  },
  "scripts": {
    "check-all": "concurrently -c \"bgBlue.bold,bgMagenta.bold,bgCyan.bold,bgGreen.bold\" npm:vue-check npm:vitest-check npm:node-check npm:conf-check",
    "conf-check": "tsc --noEmit -p tsconfig/tsconfig.tools.json",
    "dev": "electron-forge start",
    "format": "prettier --write src/ main/ web/ types/ *.ts *.json *.md",
    "web:dev": "concurrently \"vite --config vite.config.web.ts\" \"npm run web:server && node dist/server.cjs --dev\"",
    "web:build": "vite build --config vite.config.web.ts && npm run web:server",
    "web:server": "esbuild web/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --alias:@shared=./shared --packages=external",
    "lint": "eslint . --fix",
    "make": "electron-forge make",
    "node-check": "tsc --noEmit -p tsconfig/tsconfig.node.json",
    "package": "electron-forge package",
    "publish": "electron-forge publish",
    "start": "electron-forge start",
    "test": "vitest",
    "vitest-check": "vue-tsc --noEmit -p tsconfig/tsconfig.vitest.json",
    "vue-check": "vue-tsc --noEmit -p tsconfig/tsconfig.app.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@replit/codemirror-vim": "^6.3.0",
    "date-fns": "^4.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "element-plus": "^2.14.2",
    "fastify": "^5.9.0",
    "hexo": "^8.1.2",
    "hexo-front-matter": "^5.0.0",
    "hexo-fs": "^5.0.0",
    "hexo-util": "^4.0.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "path-browserify": "^1.0.1",
    "pinia": "^3.0.3",
    "una-editor": "^0.4.0",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vue3-calendar-heatmap": "^2.0.5"
  },
  "overrides": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@tsconfig/node20": "^20.1.6",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.1",
    "@types/path-browserify": "^1.0.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "electron": "^42.5.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unocss": "^66.7.4",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5",
    "web-storage-cache": "^1.1.1"
  },
  "productName": "HexoPress"
}
